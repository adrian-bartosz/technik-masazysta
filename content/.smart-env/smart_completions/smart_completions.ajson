
"smart_completions:Untitled Chat 2025-10-28 08-55-11-1761638111135": {"completion":{"request":{"messages":[{"role":"user","content":[{"type":"text","text":"hej co mam o miesniach piersiowych?"}]}]},"responses":[],"chat_model":{"platform_key":"ollama"}},"key":"Untitled Chat 2025-10-28 08-55-11-1761638111135","thread_key":"Untitled Chat 2025-10-28 08-55-11","stream":true,"context_key":"1761638111135","class_name":"SmartCompletion","user_message":"hej co mam o miesniach piersiowych?","new_user_message":true},
